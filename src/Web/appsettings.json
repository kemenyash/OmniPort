{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
    "RuntimeLogging": {
      "MinimumLevel": "Information",
      "FilePath": "logs/omniport-app.jsonl"
    },
    "UploadLimits": {
      "MaxUploadBytes": 209715200, // 200 MB
      "InMemoryThresholdBytes": 33554432, // 32 MB
      "PerType": {
        "Excel": 104857600, // 100 MB
        "Csv": 52428800, // 50 MB
        "Json": 20971520, // 20 MB
        "Xml": 20971520 // 20 MB
      }
    },
  "AllowedHosts": "*"
}
