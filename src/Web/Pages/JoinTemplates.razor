@page "/join-templates"
@using System.Linq
@using Microsoft.AspNetCore.Authorization
@using BusinessLogic.Enums
@using BusinessLogic.Records
@using Presentation.Inherits.Pages
@attribute [Authorize]
@inherits JoinTemplatesBase
@inject IAppLocalizer L

<h1 class="mb-5 text-2xl font-semibold tracking-tight text-gray-950">@L["TransformingTemplates"]</h1>

@if (ViewModel.Templates.Count == 0)
{
    <div class="rounded-lg border border-gray-200 bg-white px-4 py-5 text-gray-600 shadow-sm">@L["LoadingTemplates"]</div>
}
else
{
    <div class="grid gap-5 xl:grid-cols-2">
        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h2 class="text-lg font-semibold text-blue-700">@L["SourceTemplate"]</h2>
                <select class="rounded border border-gray-300 bg-white px-3 py-2 text-sm"
                        value="@ViewModel.SourceId"
                        @onchange="OnSourceChanged">
                    <option disabled value="">@L["SelectTemplate"]</option>
                    @foreach (var template in ViewModel.Templates)
                    {
                        <option value="@template.Id">@template.Name</option>
                    }
                </select>
            </div>

            <p class="mb-3 text-sm text-gray-500">@L["FieldsFromOriginalData"]</p>

            @if (ViewModel.SourceTemplate?.Fields is { Count: > 0 } roots)
            {
                <ul class="list-disc pl-5 space-y-1">
                    @foreach (var templateField in roots)
                    {
                        <SourceFieldTree Node="templateField" />
                    }
                </ul>
            }
            else
            {
                <div class="text-gray-500 italic">@L["NoFields"]</div>
            }
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <h2 class="text-lg font-semibold text-emerald-700">@L["InternalCrmSchema"]</h2>
                <select class="rounded border border-gray-300 bg-white px-3 py-2 text-sm"
                        value="@ViewModel.TargetId"
                        @onchange="OnTargetChanged">
                    <option disabled value="">@L["SelectSchema"]</option>
                    @foreach (var template in ViewModel.Templates)
                    {
                        <option value="@template.Id">@template.Name</option>
                    }
                </select>
            </div>

            <p class="mb-3 text-sm text-gray-500">
                @L["MatchSourceFields"]
            </p>

            @if (ViewModel.TargetFlattened?.Any() == true)
            {
                <div class="space-y-3">
                    @foreach (var node in ViewModel.TargetFlattened)
                    {
                        var indent = ViewModel.GetDepth(node.Path) * 12;

                        @if (node.Type == FieldDataType.Object || node.Type == FieldDataType.Array)
                        {
                            <div class="font-semibold mt-2"
                                 style="@($"margin-left:{indent}px")">
                                @node.Path (@L.Enum(node.Type))
                            </div>
                        }
                        else
                        {
                            var current = ViewModel.GetMappedValue(node.Path);
                            var topValue = ViewModel.GetTopSelectValue(current);

                            <div class="mb-3"
                                 style="@($"margin-left:{indent}px")">

                                <label class="block text-sm font-medium">
                                    @node.Path (@L.Enum(node.Type))
                                </label>

                                <select class="mt-1 w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm"
                                        value="@topValue"
                                        @onchange="eventArgs => OnMapFieldChanged(node.Path, eventArgs)">
                                    <option value="">@L["NotMapped"]</option>
                                    @foreach (var flatField in ViewModel.SourceFlattened)
                                    {
                                        if (ViewModel.IsTopOptionCandidate(flatField))
                                        {
                                            <option value="@flatField.Path">@flatField.Path (@L.Enum(flatField.Type))</option>
                                        }
                                    }
                                </select>

                                @if (!string.IsNullOrWhiteSpace(topValue) && ViewModel.HasDescendants(topValue!))
                                {
                                    <div class="mt-2">
                                        <label class="block text-xs text-gray-600">
                                            @L["Inside"] @topValue
                                        </label>

                                        <select class="mt-1 w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm"
                                                value="@(current ?? topValue)"
                                                @onchange="eventArgs => OnMapFieldChanged(node.Path, eventArgs)">

                                            <option value="@topValue">
                                                @L["MapWhole"] @topValue
                                            </option>

                                            @{
                                                var baseDepth = ViewModel.GetDepth(topValue!);
                                            }

                                            @foreach (var flatField in ViewModel.GetDescendants(topValue!))
                                            {
                                                var depth = Math.Max(0, ViewModel.GetDepth(flatField.Path) - baseDepth);
                                                var label = ViewModel.GetIndentedLabel(flatField.Path, flatField.Type, depth);

                                                <option value="@flatField.Path">@label</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="text-gray-500 italic">@L["SelectTargetTemplateToMap"]</div>
            }
        </div>
    </div>

    <button @onclick="SaveMapping"
            class="mt-5 rounded bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 disabled:opacity-50"
            disabled="@(!ViewModel.CanSave)">
        @L["SaveMapping"]
    </button>

    <div class="my-6 h-px bg-gray-200"></div>

    <h2 class="mb-4 text-xl font-semibold text-gray-950">@L["SavedJoinTemplates"]</h2>

    @if (ViewModel.JoinedTemplates.Any())
    {
        <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-left text-gray-600">
                    <tr>
                        <th class="px-4 py-3 font-medium">@L["SourceTemplate"]</th>
                        <th class="px-4 py-3 font-medium">@L["TargetTemplate"]</th>
                        <th class="px-4 py-3 text-right font-medium">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var join in ViewModel.JoinedTemplates)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3">@join.SourceTemplate</td>
                            <td class="px-4 py-3">@join.TargetTemplate</td>
                            <td class="px-4 py-3 text-right">
                                <button @onclick="() => DeleteJoinTemplate(join.Id)"
                                        class="rounded border border-red-200 px-3 py-1.5 text-red-700 hover:bg-red-50">
                                    @L["Delete"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-gray-500">@L["NoSavedJoinTemplates"]</p>
    }
}
