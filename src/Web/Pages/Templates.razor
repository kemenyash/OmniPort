@page "/templates"
@using BusinessLogic.Enums
@using Presentation.Inherits.Pages
@using Presentation.Models
@using Presentation.ViewModels.Pages
@inherits TemplatesBase
@inject IAppLocalizer L

<div class="mb-5 flex flex-col gap-3 pr-14 sm:flex-row sm:items-center sm:justify-between sm:pr-16">
    <h1 class="text-2xl font-semibold tracking-tight text-gray-950">@L["BasicTemplates"]</h1>
    <button class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
            @onclick="StartCreate">
        @L["CreateTemplate"]
    </button>
</div>

<div class="mb-6 overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-gray-600">
            <tr class="text-left">
                <th class="px-4 py-3 font-medium">@L["Name"]</th>
                <th class="px-4 py-3 font-medium">@L["Fields"]</th>
                <th class="px-4 py-3 font-medium">@L["SourceType"]</th>
                <th class="px-4 py-3 text-right font-medium">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @if (ViewModel.Templates.Any())
            {
                @foreach (var templateSummary in ViewModel.Templates)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 font-medium text-gray-900">@templateSummary.Name</td>
                        <td class="px-4 py-3 text-gray-700">@templateSummary.FieldsCount</td>
                        <td class="px-4 py-3 text-gray-700">@L.Enum(templateSummary.SourceType)</td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <button class="rounded border border-blue-200 px-3 py-1.5 text-blue-700 hover:bg-blue-50"
                                        @onclick="() => StartEdit(templateSummary.Id)">
                                    @L["Edit"]
                                </button>
                                <button class="rounded border border-red-200 px-3 py-1.5 text-red-700 hover:bg-red-50"
                                        @onclick="() => Delete(templateSummary.Id)">
                                    @L["Delete"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="px-4 py-6 text-center text-gray-500">@L["NoTemplatesFound"]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewModel.IsModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-950/50 p-4">
        <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-lg bg-white p-5 shadow-xl sm:p-6" @onclick:stopPropagation>
            <h2 class="mb-4 text-xl font-semibold text-gray-950">
                @((ViewModel.EditingTemplateId == null) ? L["CreateTemplate"] : L["EditTemplate"])
            </h2>

            <EditForm Model="@ViewModel.CurrentTemplate"
                      OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-4">
                    <label class="block font-medium mb-1">@L["TemplateName"]</label>
                    <InputText class="w-full rounded border border-gray-300 px-3 py-2"
                               @bind-Value="ViewModel.CurrentTemplate.Name" />
                    <ValidationMessage For="@(() => ViewModel.CurrentTemplate.Name)" />
                </div>

                <div class="mb-4">
                    <label class="block font-medium mb-1">@L["SourceType"]</label>
                    <InputSelect class="w-full rounded border border-gray-300 px-3 py-2"
                                 @bind-Value="ViewModel.SelectedSourceType">
                        @foreach (SourceType sourceType in Enum.GetValues(typeof(SourceType)))
                        {
                            <option value="@sourceType">@L.Enum(sourceType)</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-4 rounded border border-gray-200 bg-gray-50 p-4">
                    <div class="font-medium mb-3">@L["GenerateTemplateFromFile"]</div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium mb-1">@L["UploadFile"]</label>
                            <InputFile OnChange="GenerateFieldsFromUpload"
                                       class="w-full rounded border border-gray-300 bg-white px-3 py-2"
                                       disabled="@ViewModel.IsInferringSchema" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium mb-1">@L["FileUrl"]</label>
                            <div class="flex gap-2">
                                <InputText class="w-full rounded border border-gray-300 px-3 py-2"
                                           @bind-Value="ViewModel.SampleUrl"
                                           placeholder="https://example.com/file.csv" />
                                <button type="button"
                                        class="rounded bg-blue-600 px-3 py-2 text-white disabled:opacity-50"
                                        disabled="@ViewModel.IsInferringSchema"
                                        @onclick="GenerateFieldsFromUrl">
                                    @L["Generate"]
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (ViewModel.IsInferringSchema)
                    {
                        <div class="text-sm text-gray-600 mt-2">@L["GeneratingFields"]</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ViewModel.SchemaInferenceError))
                    {
                        <div class="text-sm text-red-600 mt-2">@L[ViewModel.SchemaInferenceError]</div>
                    }
                </div>

                <div class="mb-4">
                    <div class="flex items-center justify-between">
                        <label class="block font-medium mb-1">@L["Fields"]</label>
                        <button type="button"
                                class="text-blue-600 hover:underline"
                                @onclick="AddField">
                            @L["AddField"]
                        </button>
                    </div>

                    @if (ViewModel.CurrentFields.Any())
                    {
                        @foreach (var field in ViewModel.CurrentFields)
                        {
                            <FieldRowEditor Field="field"
                                            Level="0"
                                            OnRemove="(() => RemoveField(field))" />
                        }
                    }
                    else
                    {
                        <div class="text-gray-500 italic">@L["NoFieldsYet"]</div>
                    }
                </div>

                <div class="flex justify-end gap-3 mt-4">
                    <button type="button"
                            class="rounded border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-100"
                            @onclick="CancelEdit">
                        @L["Cancel"]
                    </button>
                    <button type="submit"
                            class="rounded bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-700">
                        @L["SaveTemplate"]
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}
