@page "/transform"
@using BusinessLogic.Models
@using Presentation.Inherits.Pages
@using Presentation.Models
@inherits TransformationBase
@inject IAppLocalizer L
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<EditForm Model="@ViewModel.FormModel" OnValidSubmit="RunTransformation">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="space-y-6">

        <div>
            <label>@L["Template"]</label>
            <InputSelect @bind-Value="@ViewModel.FormModel.SelectedMappingTemplateId"
                         class="w-full border px-3 py-2 rounded">
                <option value="0" disabled>@L["SelectTemplate"]</option>
                @foreach (var joinedTemplate in ViewModel.JoinedTemplates)
                {
                    <option value="@joinedTemplate.Id">@joinedTemplate.FullName</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => ViewModel.FormModel.SelectedMappingTemplateId)" />
        </div>

        <div class="flex gap-4 items-center">
            <label>@L["ImportMode"]</label>
            <button type="button"
                    @onclick="() => SetMode(UploadMode.Upload)"
                    class="@ViewModel.GetButtonClass(UploadMode.Upload)">
                @L["Upload"]
            </button>
            <button type="button"
                    @onclick="() => SetMode(UploadMode.Url)"
                    class="@ViewModel.GetButtonClass(UploadMode.Url)">
                @L["Url"]
            </button>
        </div>

        @if (ViewModel.InputMode == UploadMode.Upload)
        {
            <div class="space-y-1">
                <label>@L["UploadFile"]</label>
                <InputFile OnChange="OnFileChange"
                           class="w-full border px-3 py-2 rounded" />

                @if (!string.IsNullOrWhiteSpace(ViewModel.FormModel.UploadedFileName))
                {
                    <div class="text-sm text-gray-600">
                        @L["Selected"] @ViewModel.FormModel.UploadedFileName
                    </div>
                }
            </div>
        }

        @if (ViewModel.InputMode == UploadMode.Url)
        {
            <div>
                <label>@L["FileUrl"]</label>
                <InputText @bind-Value="ViewModel.FormModel.FileUrl"
                           class="w-full border px-3 py-2 rounded"
                           placeholder="https://example.com/file.xlsx" />
                <ValidationMessage For="@(() => ViewModel.FormModel.FileUrl)" />
            </div>

            <div>
                <label>@L["CheckIntervalMin"]</label>
                <InputNumber @bind-Value="ViewModel.FormModel.IntervalMinutes"
                             class="w-32 border px-3 py-2 rounded"
                             min="1" max="1440" />
                <ValidationMessage For="@(() => ViewModel.FormModel.IntervalMinutes)" />
            </div>
        }

        <div class="flex items-center gap-3">
            <button type="submit"
                    class="bg-green-600 text-white px-4 py-2 rounded disabled:opacity-50"
                    disabled="@(!ViewModel.CanRun || ViewModel.IsBusy)">
                @(ViewModel.IsBusy ? L["Processing"] : L["RunTransformation"])
            </button>

            @if (ViewModel.InputMode == UploadMode.Url)
            {
                <button type="button"
                        class="bg-indigo-600 text-white px-4 py-2 rounded disabled:opacity-50"
                        disabled="@(!ViewModel.CanAddToWatchlist || ViewModel.IsBusy)"
                        @onclick="AddToWatchlistFromForm">
                    @L["AddToWatchlist"]
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <div class="text-red-600">@ViewModel.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.SuccessMessage))
        {
            <div class="rounded border border-green-200 bg-green-50 px-4 py-3 text-green-800">
                <div>@L["TransformationCompleted"]</div>
                @if (!string.IsNullOrWhiteSpace(ViewModel.LastOutputLink))
                {
                    <div class="mt-2 flex items-center gap-2">
                        <a href="@ViewModel.LastOutputLink" target="_blank" class="text-green-700 underline">
                            @L["OpenLatestResult"]
                        </a>
                        <button type="button"
                                class="inline-flex h-8 w-8 items-center justify-center rounded border border-green-300 text-green-700 hover:bg-green-100"
                                title="@L["CopyLink"]"
                                aria-label="@L["CopyLink"]"
                                @onclick="() => CopyLink(ViewModel.LastOutputLink)">
                            @CopyIcon
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</EditForm>

<hr class="my-10" />

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.WatchedUrls.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["WatchedUrls"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["Url"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["IntervalMin"]</th>
                <th class="px-4 py-2 text-left">@L["StableLink"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var watchedUrl in ViewModel.WatchedUrls)
            {
                <tr>
                    <td class="border px-4 py-2">@watchedUrl.Url</td>
                    <td class="border px-4 py-2">@watchedUrl.MappingTemplateName</td>
                    <td class="border px-4 py-2">@watchedUrl.IntervalMinutes</td>
                    <td class="border px-4 py-2">
                        @{
                            var stableLink = $"/watch/{watchedUrl.Id}/latest";
                        }
                        <div class="flex items-center gap-2">
                            <a href="@stableLink" target="_blank" class="text-blue-600 underline">
                                @L["LatestResult"]
                            </a>
                            <button type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                    title="@L["CopyStableLink"]"
                                    aria-label="@L["CopyStableLink"]"
                                    @onclick="() => CopyLink(stableLink)">
                                @CopyIcon
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.UrlConversions.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["UrlConversionHistory"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["InputUrl"]</th>
                <th class="px-4 py-2 text-left">@L["ConvertedAt"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["Output"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var urlConversionHistoryItem in ViewModel.UrlConversions)
            {
                <tr>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.InputUrl</td>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.MappingTemplateName</td>
                    <td class="border px-4 py-2">
                        <div class="flex items-center gap-2">
                            <a href="@urlConversionHistoryItem.OutputLink" target="_blank" class="text-blue-600 underline">@L["View"]</a>
                            <button type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                    title="@L["CopyLink"]"
                                    aria-label="@L["CopyLink"]"
                                    @onclick="() => CopyLink(urlConversionHistoryItem.OutputLink)">
                                @CopyIcon
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewModel.InputMode == UploadMode.Upload && ViewModel.FileConversions.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["FileConversionHistory"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["FileName"]</th>
                <th class="px-4 py-2 text-left">@L["ConvertedAt"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["Output"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fileConversionHistoryItem in ViewModel.FileConversions)
            {
                <tr>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.FileName</td>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.MappingTemplateName</td>
                    <td class="border px-4 py-2">
                        <div class="flex items-center gap-2">
                            <a href="@fileConversionHistoryItem.OutputLink" target="_blank" class="text-blue-600 underline">@L["View"]</a>
                            <button type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                    title="@L["CopyLink"]"
                                    aria-label="@L["CopyLink"]"
                                    @onclick="() => CopyLink(fileConversionHistoryItem.OutputLink)">
                                @CopyIcon
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrWhiteSpace(copiedLinkMessage))
{
    <div class="fixed bottom-4 right-4 rounded bg-gray-900 px-4 py-2 text-sm text-white shadow-lg">
        @copiedLinkMessage
    </div>
}

@code {
    private string? copiedLinkMessage;

    private static RenderFragment CopyIcon => builder =>
    {
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "xmlns", "http://www.w3.org/2000/svg");
        builder.AddAttribute(2, "viewBox", "0 0 24 24");
        builder.AddAttribute(3, "fill", "none");
        builder.AddAttribute(4, "stroke", "currentColor");
        builder.AddAttribute(5, "stroke-width", "2");
        builder.AddAttribute(6, "stroke-linecap", "round");
        builder.AddAttribute(7, "stroke-linejoin", "round");
        builder.AddAttribute(8, "class", "h-4 w-4");
        builder.OpenElement(9, "rect");
        builder.AddAttribute(10, "width", "14");
        builder.AddAttribute(11, "height", "14");
        builder.AddAttribute(12, "x", "8");
        builder.AddAttribute(13, "y", "8");
        builder.AddAttribute(14, "rx", "2");
        builder.AddAttribute(15, "ry", "2");
        builder.CloseElement();
        builder.OpenElement(16, "path");
        builder.AddAttribute(17, "d", "M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2");
        builder.CloseElement();
        builder.CloseElement();
    };

    private async Task CopyLink(string? link)
    {
        if (string.IsNullOrWhiteSpace(link))
        {
            return;
        }

        var absoluteLink = NavigationManager.ToAbsoluteUri(link).ToString();

        try
        {
            var copied = await JsRuntime.InvokeAsync<bool>("omniPortClipboard.copyText", absoluteLink);
            copiedLinkMessage = copied ? L["LinkCopied"] : L["LinkCopyFailed"];
        }
        catch
        {
            copiedLinkMessage = L["LinkCopyFailed"];
        }

        StateHasChanged();
        await Task.Delay(1600);
        copiedLinkMessage = null;
        StateHasChanged();
    }
}
