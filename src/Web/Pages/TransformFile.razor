@page "/transform"
@using BusinessLogic.Models
@using Presentation.Inherits.Pages
@using Presentation.Models
@inherits TransformationBase
@inject IAppLocalizer L
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<EditForm Model="@ViewModel.FormModel" OnValidSubmit="RunTransformation">
    <DataAnnotationsValidator />
    <ValidationSummary class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" />

    <section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-700">@L["Template"]</label>
            <InputSelect @bind-Value="@ViewModel.FormModel.SelectedMappingTemplateId"
                             class="w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                <option value="0" disabled>@L["SelectTemplate"]</option>
                @foreach (var joinedTemplate in ViewModel.JoinedTemplates)
                {
                    <option value="@joinedTemplate.Id">@joinedTemplate.FullName</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => ViewModel.FormModel.SelectedMappingTemplateId)" />
            </div>

            <div>
                <div class="mb-1 text-sm font-medium text-gray-700">@L["ImportMode"]</div>
                <div class="inline-flex rounded border border-gray-200 bg-gray-50 p-0.5">
                    <button type="button"
                            @onclick="() => SetMode(UploadMode.Upload)"
                            class="@GetModeButtonClass(UploadMode.Upload)">
                        @L["Upload"]
                    </button>
                    <button type="button"
                            @onclick="() => SetMode(UploadMode.Url)"
                            class="@GetModeButtonClass(UploadMode.Url)">
                        @L["Url"]
                    </button>
                </div>
            </div>
        </div>

        <div class="mt-5 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
            @if (ViewModel.InputMode == UploadMode.Upload)
            {
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-gray-700">@L["UploadFile"]</label>
                    <InputFile OnChange="OnFileChange"
                               class="w-full rounded border border-dashed border-gray-300 bg-gray-50 px-3 py-2 text-sm" />

                    @if (!string.IsNullOrWhiteSpace(ViewModel.FormModel.UploadedFileName))
                    {
                        <div class="text-sm text-gray-600">
                            @L["Selected"] @ViewModel.FormModel.UploadedFileName
                        </div>
                    }
                </div>
            }

            @if (ViewModel.InputMode == UploadMode.Url)
            {
                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">@L["FileUrl"]</label>
                    <InputText @bind-Value="ViewModel.FormModel.FileUrl"
                               class="w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
                               placeholder="https://example.com/file.xlsx" />
                    <ValidationMessage For="@(() => ViewModel.FormModel.FileUrl)" />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-700">@L["CheckIntervalMin"]</label>
                    <InputNumber @bind-Value="ViewModel.FormModel.IntervalMinutes"
                                 class="w-36 rounded border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
                                 min="1" max="1440" />
                    <ValidationMessage For="@(() => ViewModel.FormModel.IntervalMinutes)" />
                </div>
            }
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="submit"
                    class="rounded bg-emerald-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 disabled:opacity-50"
                    disabled="@(!ViewModel.CanRun || ViewModel.IsBusy)">
                @(ViewModel.IsBusy ? L["Processing"] : L["RunTransformation"])
            </button>

            @if (ViewModel.InputMode == UploadMode.Url)
            {
                <button type="button"
                        class="rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:opacity-50"
                        disabled="@(!ViewModel.CanAddToWatchlist || ViewModel.IsBusy)"
                        @onclick="AddToWatchlistFromForm">
                    @L["AddToWatchlist"]
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <div class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@ViewModel.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(ViewModel.SuccessMessage))
        {
            <div class="mt-4 rounded border border-green-200 bg-green-50 px-4 py-3 text-green-800">
                <div>@L["TransformationCompleted"]</div>
                @if (!string.IsNullOrWhiteSpace(ViewModel.LastOutputLink))
                {
                    <div class="mt-2 flex items-center gap-2">
                        <a href="@ViewModel.LastOutputLink" target="_blank" class="text-green-700 underline">
                            @L["OpenLatestResult"]
                        </a>
                        <button type="button"
                                class="inline-flex h-8 w-8 items-center justify-center rounded border border-green-300 text-green-700 hover:bg-green-100"
                                title="@L["CopyLink"]"
                                aria-label="@L["CopyLink"]"
                                @onclick="() => CopyLink(ViewModel.LastOutputLink)">
                            @CopyIcon
                        </button>
                    </div>
                }
            </div>
        }
    </section>
</EditForm>

<div class="my-6 h-px bg-gray-200"></div>

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.WatchedUrls.Any())
{
    <section class="mb-6 rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-100 px-4 py-3">
            <h2 class="text-lg font-semibold text-gray-950">@L["WatchedUrls"]</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-3 text-left font-medium">@L["Url"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["Template"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["IntervalMin"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["StableLink"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var watchedUrl in ViewModel.WatchedUrls)
                    {
                        <tr class="align-top hover:bg-gray-50">
                            <td class="max-w-[360px] px-4 py-3 text-gray-700">
                                <div class="truncate" title="@watchedUrl.Url">@watchedUrl.Url</div>
                            </td>
                            <td class="px-4 py-3 text-gray-700">@watchedUrl.MappingTemplateName</td>
                            <td class="px-4 py-3 text-gray-700">@watchedUrl.IntervalMinutes</td>
                            <td class="px-4 py-3">
                                @{
                                    var stableLink = $"/watch/{watchedUrl.Id}/latest";
                                }
                                <div class="flex items-center gap-2">
                                    <a href="@stableLink" target="_blank" class="font-medium text-blue-600 hover:underline">
                                        @L["LatestResult"]
                                    </a>
                                    <button type="button"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                            title="@L["CopyStableLink"]"
                                            aria-label="@L["CopyStableLink"]"
                                            @onclick="() => CopyLink(stableLink)">
                                        @CopyIcon
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.UrlConversions.Any())
{
    <section class="mb-6 rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-100 px-4 py-3">
            <h2 class="text-lg font-semibold text-gray-950">@L["UrlConversionHistory"]</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-3 text-left font-medium">@L["InputUrl"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["ConvertedAt"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["Template"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["Output"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var urlConversionHistoryItem in ViewModel.UrlConversions)
                    {
                        <tr class="align-top hover:bg-gray-50">
                            <td class="max-w-[360px] px-4 py-3 text-gray-700">
                                <div class="truncate" title="@urlConversionHistoryItem.InputUrl">@urlConversionHistoryItem.InputUrl</div>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 text-gray-700">@urlConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                            <td class="px-4 py-3 text-gray-700">@urlConversionHistoryItem.MappingTemplateName</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <a href="@urlConversionHistoryItem.OutputLink" target="_blank" class="font-medium text-blue-600 hover:underline">@L["View"]</a>
                                    <button type="button"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                            title="@L["CopyLink"]"
                                            aria-label="@L["CopyLink"]"
                                            @onclick="() => CopyLink(urlConversionHistoryItem.OutputLink)">
                                        @CopyIcon
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (ViewModel.InputMode == UploadMode.Upload && ViewModel.FileConversions.Any())
{
    <section class="mb-6 rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-100 px-4 py-3">
            <h2 class="text-lg font-semibold text-gray-950">@L["FileConversionHistory"]</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-3 text-left font-medium">@L["FileName"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["ConvertedAt"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["Template"]</th>
                        <th class="px-4 py-3 text-left font-medium">@L["Output"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var fileConversionHistoryItem in ViewModel.FileConversions)
                    {
                        <tr class="align-top hover:bg-gray-50">
                            <td class="px-4 py-3 text-gray-700">@fileConversionHistoryItem.FileName</td>
                            <td class="whitespace-nowrap px-4 py-3 text-gray-700">@fileConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                            <td class="px-4 py-3 text-gray-700">@fileConversionHistoryItem.MappingTemplateName</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <a href="@fileConversionHistoryItem.OutputLink" target="_blank" class="font-medium text-blue-600 hover:underline">@L["View"]</a>
                                    <button type="button"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
                                            title="@L["CopyLink"]"
                                            aria-label="@L["CopyLink"]"
                                            @onclick="() => CopyLink(fileConversionHistoryItem.OutputLink)">
                                        @CopyIcon
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(copiedLinkMessage))
{
    <div class="fixed bottom-4 right-4 rounded bg-gray-900 px-4 py-2 text-sm text-white shadow-lg">
        @copiedLinkMessage
    </div>
}

@code {
    private string? copiedLinkMessage;

    private string GetModeButtonClass(UploadMode mode)
    {
        return ViewModel.InputMode == mode
            ? "rounded px-3 py-1.5 text-sm font-medium bg-blue-600 text-white shadow-sm"
            : "rounded px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-white";
    }

    private static RenderFragment CopyIcon => builder =>
    {
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "xmlns", "http://www.w3.org/2000/svg");
        builder.AddAttribute(2, "viewBox", "0 0 24 24");
        builder.AddAttribute(3, "fill", "none");
        builder.AddAttribute(4, "stroke", "currentColor");
        builder.AddAttribute(5, "stroke-width", "2");
        builder.AddAttribute(6, "stroke-linecap", "round");
        builder.AddAttribute(7, "stroke-linejoin", "round");
        builder.AddAttribute(8, "class", "h-4 w-4");
        builder.OpenElement(9, "rect");
        builder.AddAttribute(10, "width", "14");
        builder.AddAttribute(11, "height", "14");
        builder.AddAttribute(12, "x", "8");
        builder.AddAttribute(13, "y", "8");
        builder.AddAttribute(14, "rx", "2");
        builder.AddAttribute(15, "ry", "2");
        builder.CloseElement();
        builder.OpenElement(16, "path");
        builder.AddAttribute(17, "d", "M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2");
        builder.CloseElement();
        builder.CloseElement();
    };

    private async Task CopyLink(string? link)
    {
        if (string.IsNullOrWhiteSpace(link))
        {
            return;
        }

        var absoluteLink = NavigationManager.ToAbsoluteUri(link).ToString();

        try
        {
            var copied = await JsRuntime.InvokeAsync<bool>("omniPortClipboard.copyText", absoluteLink);
            copiedLinkMessage = copied ? L["LinkCopied"] : L["LinkCopyFailed"];
        }
        catch
        {
            copiedLinkMessage = L["LinkCopyFailed"];
        }

        StateHasChanged();
        await Task.Delay(1600);
        copiedLinkMessage = null;
        StateHasChanged();
    }
}
