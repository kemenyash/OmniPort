@page "/transform"
@using BusinessLogic.Models
@using Presentation.Inherits.Pages
@using Presentation.Models
@inherits TransformationBase
@inject IAppLocalizer L

<EditForm Model="@ViewModel.FormModel" OnValidSubmit="RunTransformation">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="space-y-6">

        <div>
            <label>@L["Template"]</label>
            <InputSelect @bind-Value="@ViewModel.FormModel.SelectedMappingTemplateId"
                         class="w-full border px-3 py-2 rounded">
                <option value="0" disabled>@L["SelectTemplate"]</option>
                @foreach (var joinedTemplate in ViewModel.JoinedTemplates)
                {
                    <option value="@joinedTemplate.Id">@joinedTemplate.FullName</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => ViewModel.FormModel.SelectedMappingTemplateId)" />
        </div>

        <div class="flex gap-4 items-center">
            <label>@L["ImportMode"]</label>
            <button type="button"
                    @onclick="() => SetMode(UploadMode.Upload)"
                    class="@ViewModel.GetButtonClass(UploadMode.Upload)">
                @L["Upload"]
            </button>
            <button type="button"
                    @onclick="() => SetMode(UploadMode.Url)"
                    class="@ViewModel.GetButtonClass(UploadMode.Url)">
                @L["Url"]
            </button>
        </div>

        @if (ViewModel.InputMode == UploadMode.Upload)
        {
            <div class="space-y-1">
                <label>@L["UploadFile"]</label>
                <InputFile OnChange="OnFileChange"
                           class="w-full border px-3 py-2 rounded" />

                @if (!string.IsNullOrWhiteSpace(ViewModel.FormModel.UploadedFileName))
                {
                    <div class="text-sm text-gray-600">
                        @L["Selected"] @ViewModel.FormModel.UploadedFileName
                    </div>
                }
            </div>
        }

        @if (ViewModel.InputMode == UploadMode.Url)
        {
            <div>
                <label>@L["FileUrl"]</label>
                <InputText @bind-Value="ViewModel.FormModel.FileUrl"
                           class="w-full border px-3 py-2 rounded"
                           placeholder="https://example.com/file.xlsx" />
                <ValidationMessage For="@(() => ViewModel.FormModel.FileUrl)" />
            </div>

            <div>
                <label>@L["CheckIntervalMin"]</label>
                <InputNumber @bind-Value="ViewModel.FormModel.IntervalMinutes"
                             class="w-32 border px-3 py-2 rounded"
                             min="1" max="1440" />
                <ValidationMessage For="@(() => ViewModel.FormModel.IntervalMinutes)" />
            </div>
        }

        <div class="flex items-center gap-3">
            <button type="submit"
                    class="bg-green-600 text-white px-4 py-2 rounded disabled:opacity-50"
                    disabled="@(!ViewModel.CanRun)">
                @L["RunTransformation"]
            </button>

            @if (ViewModel.InputMode == UploadMode.Url)
            {
                <button type="button"
                        class="bg-indigo-600 text-white px-4 py-2 rounded disabled:opacity-50"
                        disabled="@(!ViewModel.CanAddToWatchlist)"
                        @onclick="AddToWatchlistFromForm">
                    @L["AddToWatchlist"]
                </button>
            }
        </div>
    </div>
</EditForm>

<hr class="my-10" />

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.WatchedUrls.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["WatchedUrls"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["Url"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["IntervalMin"]</th>
                <th class="px-4 py-2 text-left">@L["StableLink"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var watchedUrl in ViewModel.WatchedUrls)
            {
                <tr>
                    <td class="border px-4 py-2">@watchedUrl.Url</td>
                    <td class="border px-4 py-2">@watchedUrl.MappingTemplateName</td>
                    <td class="border px-4 py-2">@watchedUrl.IntervalMinutes</td>
                    <td class="border px-4 py-2">
                        <a href="@($"/watch/{watchedUrl.Id}/latest")" target="_blank" class="text-blue-600 underline">
                            @L["LatestResult"]
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewModel.InputMode == UploadMode.Url && ViewModel.UrlConversions.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["UrlConversionHistory"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["InputUrl"]</th>
                <th class="px-4 py-2 text-left">@L["ConvertedAt"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["Output"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var urlConversionHistoryItem in ViewModel.UrlConversions)
            {
                <tr>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.InputUrl</td>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                    <td class="border px-4 py-2">@urlConversionHistoryItem.MappingTemplateName</td>
                    <td class="border px-4 py-2">
                        <a href="@urlConversionHistoryItem.OutputLink" target="_blank" class="text-blue-600 underline">@L["View"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewModel.InputMode == UploadMode.Upload && ViewModel.FileConversions.Any())
{
    <h2 class="text-lg font-semibold mb-2">@L["FileConversionHistory"]</h2>
    <table class="w-full table-auto border border-gray-300">
        <thead>
            <tr class="bg-gray-100">
                <th class="px-4 py-2 text-left">@L["FileName"]</th>
                <th class="px-4 py-2 text-left">@L["ConvertedAt"]</th>
                <th class="px-4 py-2 text-left">@L["Template"]</th>
                <th class="px-4 py-2 text-left">@L["Output"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fileConversionHistoryItem in ViewModel.FileConversions)
            {
                <tr>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.FileName</td>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.ConvertedAt.ToLocalTime()</td>
                    <td class="border px-4 py-2">@fileConversionHistoryItem.MappingTemplateName</td>
                    <td class="border px-4 py-2">
                        <a href="@fileConversionHistoryItem.OutputLink" target="_blank" class="text-blue-600 underline">@L["View"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
