@page "/account"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject IAppLocalizer L

<h1 class="mb-5 text-2xl font-semibold tracking-tight text-gray-950">@L["Account"]</h1>

<section class="max-w-xl rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <form action="/auth/change-password" method="post" class="space-y-4">
        <AntiforgeryToken />

        <div>
            <label class="mb-1 block text-sm font-medium text-gray-700" for="current-password">@L["CurrentPassword"]</label>
            <input id="current-password"
                   name="CurrentPassword"
                   type="password"
                   required
                   class="w-full rounded border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-gray-700" for="new-password">@L["NewPassword"]</label>
            <input id="new-password"
                   name="NewPassword"
                   type="password"
                   required
                   minlength="6"
                   class="w-full rounded border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-gray-700" for="confirm-password">@L["ConfirmPassword"]</label>
            <input id="confirm-password"
                   name="ConfirmPassword"
                   type="password"
                   required
                   minlength="6"
                   class="w-full rounded border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100" />
        </div>

        <button type="submit"
                class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700">
            @L["ChangePassword"]
        </button>

        @if (string.Equals(PasswordStatus, "changed", StringComparison.OrdinalIgnoreCase))
        {
            <div class="rounded border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">@L["PasswordChanged"]</div>
        }
        else if (string.Equals(PasswordStatus, "mismatch", StringComparison.OrdinalIgnoreCase))
        {
            <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@L["PasswordConfirmationMismatch"]</div>
        }
        else if (string.Equals(PasswordStatus, "error", StringComparison.OrdinalIgnoreCase))
        {
            <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@L["PasswordChangeFailed"]</div>
        }
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "passwordStatus")]
    private string? PasswordStatus { get; set; }
}
